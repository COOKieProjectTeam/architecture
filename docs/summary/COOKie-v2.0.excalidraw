    {
      "id": "t1061",
      "type": "text",
      "x": 104,
      "y": 2482,
      "width": 400,
      "height": 124,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1062,
      "version": 2,
      "versionNonce": 916686222,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777235543505,
      "link": null,
      "locked": false,
      "text": "• ExceptionHandlingMiddleware:\n    - ловит unhandled exceptions\n    - формирует структурный JSON-лог через Serilog (stdout + файл)\n    - вставляет запись в Postgres: error_logs\n       (id, traceId, level, message, stackTrace,\n        requestPath, userId, createdAt)\n• Корреляция: W3C traceparent (заголовок X-Trace-Id),\n    единый id \"пробивает\" frontend → API → DB-запрос\n• Retention error_logs: 30 дней (cron VACUUM)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• ExceptionHandlingMiddleware:\n    - ловит unhandled exceptions\n    - формирует структурный JSON-лог через Serilog (stdout + файл)\n    - вставляет запись в Postgres: error_logs\n       (id, traceId, level, message, stackTrace,\n        requestPath, userId, createdAt)\n• Корреляция: W3C traceparent (заголовок X-Trace-Id),\n    единый id \"пробивает\" frontend → API → DB-запрос\n• Retention error_logs: 30 дней (cron VACUUM)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4h"
    },
