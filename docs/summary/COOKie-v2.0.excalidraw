      "versionNonce": 236150418,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777235922781,
      "link": null,
      "locked": false,
      "text": "Interface (Controllers):\n  AuthController, RecipesController, FavoritesController,\n  RatingsController, UsersController, AdminController,\n  UploadsController, MetricsController, ErrorsController\n\nApplication (Use Cases / Services):\n  RecipeSearchService, NutritionCalculator, FavoritesService,\n  StatsService, AuthService, ImageService\n\nDomain:\n  Entities — Recipe, User, Favorite, Rating, Session,\n             ErrorLog, MetricEvent\n  ValueObjects — Nutrition, DietaryTags, Allergens\n\nInfrastructure:\n  Repositories (EF Core), IFileStorage→S3, ICacheStore→Redis\n\nCross-cutting middleware:\n  JwtAuth, FluentValidation, ExceptionHandling,\n  RequestLogging (Serilog), Metrics, CORS",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interface (Controllers):\n  AuthController, RecipesController, FavoritesController,\n  RatingsController, UsersController, AdminController,\n  UploadsController, MetricsController, ErrorsController\n\nApplication (Use Cases / Services):\n  RecipeSearchService, NutritionCalculator, FavoritesService,\n  StatsService, AuthService, ImageService\n\nDomain:\n  Entities — Recipe, User, Favorite, Rating, Session,\n             ErrorLog, MetricEvent\n  ValueObjects — Nutrition, DietaryTags, Allergens\n\nInfrastructure:\n  Repositories (EF Core), IFileStorage→S3, ICacheStore→Redis\n\nCross-cutting middleware:\n  JwtAuth, FluentValidation, ExceptionHandling,\n  RequestLogging (Serilog), Metrics, CORS",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0s"
    },
