      "boundElements": [],
      "updated": 1777235543505,
      "link": null,
      "locked": false,
      "text": "FSD-подобная структура:\n• app/         — routes, layouts (RSC + Client)\n• features/    — auth, recipe-search, recipe-detail,\n                 favorites, rating, profile-stats\n• entities/    — recipe, user, nutrition\n• shared/api/  — axios + interceptors, query-keys\n• shared/ui/   — Button, Card, Modal на\n                 styled-components + ThemeProvider\n• shared/lib/  — zod-схемы, formatters, hooks\n\nРендеринг: SSR / ISR / RSC, next/image для S3,\nnext/font (self-hosted)\nСостояние: TanStack Query (server) + Zustand (UI)\nMock: MSW (dev) перехватывает /api/v1/*",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FSD-подобная структура:\n• app/         — routes, layouts (RSC + Client)\n• features/    — auth, recipe-search, recipe-detail,\n                 favorites, rating, profile-stats\n• entities/    — recipe, user, nutrition\n• shared/api/  — axios + interceptors, query-keys\n• shared/ui/   — Button, Card, Modal на\n                 styled-components + ThemeProvider\n• shared/lib/  — zod-схемы, formatters, hooks\n\nРендеринг: SSR / ISR / RSC, next/image для S3,\nnext/font (self-hosted)\nСостояние: TanStack Query (server) + Zustand (UI)\nMock: MSW (dev) перехватывает /api/v1/*",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0p"
    },
