    {
      "id": "t350",
      "type": "text",
      "x": -375.59833277543976,
      "y": 162.99951189954368,
      "width": 470,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
