      "versionNonce": 919131854,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777235543505,
      "link": null,
      "locked": false,
      "text": "1. Browser → GET https://oauth.yandex.ru/authorize\n        ?response_type=code&client_id=...&redirect_uri=.../oauth/yandex/callback\n2. API ← code  →  POST https://oauth.yandex.ru/token (обмен)\n3. API → GET https://login.yandex.ru/info  (профиль)\nScope: login:email login:info",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Browser → GET https://oauth.yandex.ru/authorize\n        ?response_type=code&client_id=...&redirect_uri=.../oauth/yandex/callback\n2. API ← code  →  POST https://oauth.yandex.ru/token (обмен)\n3. API → GET https://login.yandex.ru/info  (профиль)\nScope: login:email login:info",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b45"
