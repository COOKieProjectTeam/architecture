      "boundElements": [],
      "updated": 1777235543505,
      "link": null,
      "locked": false,
      "text": "(public) — без guard\n  /                       — главная: hero + популярные\n  /login                  — вход (email + OAuth: Yandex ID, T-ID)\n  /register               — регистрация\n  /forgot-password        — сброс пароля по email-токену (TTL 1ч)\n  /recipes                — каталог: search + filters + grid\n  /recipes/[slug]         — карточка рецепта (вкладки: Обзор/Ингр./Шаги/БЖУ/История)\n\n(auth) — middleware проверяет JWT\n  /profile                — профиль + статистика просмотров/избранного\n  /favorites              — список избранного\n  /settings               — аллергии, диета, цели\n\n(admin) — middleware проверяет role=Admin\n  /admin                  — дашборд\n  /admin/recipes/new      — создание рецепта (NutritionCalculator)\n  /admin/recipes/[id]/edit\n  /admin/stats            — встроенный дашборд метрик (recharts)\n  /admin/errors           — просмотр error_logs",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(public) — без guard\n  /                       — главная: hero + популярные\n  /login                  — вход (email + OAuth: Yandex ID, T-ID)\n  /register               — регистрация\n  /forgot-password        — сброс пароля по email-токену (TTL 1ч)\n  /recipes                — каталог: search + filters + grid\n  /recipes/[slug]         — карточка рецепта (вкладки: Обзор/Ингр./Шаги/БЖУ/История)\n\n(auth) — middleware проверяет JWT\n  /profile                — профиль + статистика просмотров/избранного\n  /favorites              — список избранного\n  /settings               — аллергии, диета, цели\n\n(admin) — middleware проверяет role=Admin\n  /admin                  — дашборд\n  /admin/recipes/new      — создание рецепта (NutritionCalculator)\n  /admin/recipes/[id]/edit\n  /admin/stats            — встроенный дашборд метрик (recharts)\n  /admin/errors           — просмотр error_logs",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1q"
    },
